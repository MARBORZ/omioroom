{
  "name": "omioroom-root",
  "version": "0.1.0",
  "private": true,
  "description": "Minimalist anonymous two-person video watch party platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "dev:server": "npm run --workspace=@omioroom/server dev",
    "dev:web": "npm run --workspace=@omioroom/web dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
