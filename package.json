{
  "name": "omioroom-root",
  "version": "0.1.0",
  "private": true,
  "description": "Minimalist watch party for two: React on Vercel + Supabase (Auth, Postgres, Realtime)",
  "workspaces": [
    "packages/*",
    "apps/*",
    "supabase"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "dev": "npm run dev:web",
    "dev:web": "npm run --workspace=@omioroom/web dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
